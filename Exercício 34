Quantidade de dias do mês

mes = int(input("Mês: "))
ano = int(input("Ano: "))

if mes < 1 or mes > 12:
    print("Resultado: MÊS INVÁLIDO")
elif mes in [1, 3, 5, 7, 8, 10, 12]:
    print("Resultado: 31 dias")
elif mes in [4, 6, 9, 11]:
    print("Resultado: 30 dias")
elif mes == 2:
    # Verificação de ano bissexto
    if (ano % 400 == 0) or (ano % 4 == 0 and ano % 100 != 0):
        print("Resultado: 29 dias")
    else:
        print("Resultado: 28 dias")
