Divisível por 3 e por 5

numero = int(input("Entrada: "))

if numero % 3 == 0 and numero % 5 == 0:
    print("Resultado: DIVISÍVEL POR 3 E 5")
elif numero % 3 == 0:
    print("Resultado: APENAS POR 3")
elif numero % 5 == 0:
    print("Resultado: APENAS POR 5")
else:
    print("Resultado: POR NENHUM")
