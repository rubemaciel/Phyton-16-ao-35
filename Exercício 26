Reajuste por faixa salarial

salario = float(input("Salário atual: R$ "))

if salario <= 1500.00:
    reajuste = 15
elif salario <= 3000.00:
    reajuste = 10
else:
    reajuste = 5

novo_salario = salario + (salario * (reajuste / 100))

print(f"Percentual: {reajuste}%")
print(f"Novo salário: R$ {novo_salario:.2f}")
